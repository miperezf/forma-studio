# FORMA Studio — variables de entorno (SIN SECRETOS). Copiar a .env.local y completar.
# La configuración web del SDK de Firebase es PÚBLICA por diseño (identifica el proyecto); la seguridad real
# la dan Authentication + reglas de Firestore/Storage. Nunca poner aquí claves de cuenta de servicio ni tokens.

# Entorno que se construye: demo | staging | production
FORMA_ENV=staging

# IDs de proyecto Firebase (también en .firebaserc, que no se versiona con IDs reales)
FIREBASE_PROJECT_STAGING=REEMPLAZAR-forma-studio-staging
FIREBASE_PROJECT_PRODUCTION=REEMPLAZAR-forma-studio-prod

# Configuración web del SDK (Gate F; aún no se usa en el staging estático)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
